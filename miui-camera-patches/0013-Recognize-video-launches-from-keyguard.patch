From 83ab088a5ac938968c3a56bd6a08027ce9e4dd1b Mon Sep 17 00:00:00 2001
From: ChrisCatto <chriscatto@proton.me>
Date: Mon, 26 Oct 2026 14:58:38 +0200
Subject: [PATCH 13/13] Recognize video launches from keyguard

Assisted-by: LLM
Change-Id: I1843d8cc1d0ad0363d8a753a0c2d29df70fc7db3
Signed-off-by: ChrisCatto <chriscatto@proton.me>
---
 .../android/camera/CameraIntentManager.smali  | 21 +++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/smali_classes3/com/android/camera/CameraIntentManager.smali b/smali_classes3/com/android/camera/CameraIntentManager.smali
index fc19c59..64a9f9e 100644
--- a/smali_classes3/com/android/camera/CameraIntentManager.smali
+++ b/smali_classes3/com/android/camera/CameraIntentManager.smali
@@ -415,8 +415,21 @@
 
     move-result v1
 
+    if-nez v1, :cond_camera_launch
+
+    const-string v2, "android.media.action.VIDEO_CAMERA"
+
+    invoke-virtual {p0}, Landroid/content/Intent;->getAction()Ljava/lang/String;
+
+    move-result-object v1
+
+    invoke-virtual {v2, v1}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v1
+
     if-eqz v1, :cond_1
 
+    :cond_camera_launch
     invoke-static {p0}, Lcom/android/camera/CameraIntentManager;->getCameraLaunchSource(Landroid/content/Intent;)Ljava/lang/String;
 
     move-result-object p0
@@ -2347,6 +2360,14 @@
     .line 4
     invoke-static {v0, v1}, Landroid/text/TextUtils;->equals(Ljava/lang/CharSequence;Ljava/lang/CharSequence;)Z
 
+    move-result v1
+
+    if-nez v1, :cond_0
+
+    const-string v1, "android.media.action.VIDEO_CAMERA"
+
+    invoke-static {v0, v1}, Landroid/text/TextUtils;->equals(Ljava/lang/CharSequence;Ljava/lang/CharSequence;)Z
+
     move-result v0
 
     if-nez v0, :cond_0
