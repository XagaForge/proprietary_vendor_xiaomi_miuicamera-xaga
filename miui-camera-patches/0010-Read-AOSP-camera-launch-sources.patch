+    :cond_1
+    # AOSP CAMERA_LAUNCH_SOURCE_QUICK_AFFORDANCE
+    const/4 v1, 0x3
+
+    if-ne v0, v1, :cond_2
+
+    const-string p0, "lockscreen_affordance"
+
+    return-object p0
+
+    :cond_2
+    const/4 p0, 0x0
+
+    return-object p0
